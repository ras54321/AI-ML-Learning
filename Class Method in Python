class laptop:
    storage_type="ssd"
    def __init__(self,RAM,storage):
        self.RAM=RAM
        self.storage=storage
    @classmethod    
    def get_storage(cls):
        print(f"Laptop has {cls.storage_type}")    
    def get_info(self):
        print(f"Laptop has {self.RAM} RAM and {self.storage} {self.storage_type}") 
L1=laptop("16gb","512gb")

L1.get_storage()            
