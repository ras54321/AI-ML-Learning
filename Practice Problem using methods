class products:
    count=0
    def __init__(self,name,price):
        self.name=name
        self.price=price
        products.count += 1
    def get_info(self):
        print(f"Product Name: {self.name}, Price: {self.price}")
    @classmethod
    def get_count(cls):
        print(f"Total Products: {cls.count}")
    @staticmethod
    def discount_price(price, discount):
       print(f"Discounted Price: {price - (price * discount / 100)}")
p1=products("Laptop", 100000)    
p2=products("Mobile", 50000)
p3=products("Tablet", 30000)
p1.discount_price(p1.price,10)
p2.discount_price(p2.price,15)
p3.discount_price(p3.price,20)
