class employee:
    start_time="10:00 AM"
    end_time="5:00 PM"
class manager(employee):
    def __init__(self,department):
        self.department=department
class teacher(manager):
    def __init__(self,subject,department):
        super().__init__(department)
        self.subject=subject
t1=teacher("Maths","Science")        
print(f"Teacher Start Time: {t1.start_time}, End Time: {t1.end_time}, Subject: {t1.subject}, Department: {t1.department}")                    
